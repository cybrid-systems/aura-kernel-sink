; scripts/kgen.aura — generate C kernels for the discovered candidates of the
; fixture workspace into build/gen/ (run via scripts/gen_kernel.sh).
(require "fixture" all:)
(require "discover" all:)
(require "kgen" all:)
(display "RUN-ONCE") (newline)
(set-code (fixture:workspace-code))
(eval-current)
(define defs (discover:defines (discover:scan)))
(define (names rows) (if (null? rows) (list) (cons (car (car rows)) (names (cdr rows)))))
(define dir (string-append (fixture:root) "/build/gen"))
(define rows (kgen:emit! defs (discover:kinds (discover:candidates defs)) dir))
(display "== kgen: discovered candidates (Int workspace) -> build/gen/*.c") (newline)
(kgen:print rows)
; Float workspace: hot-fsum is classified Float and gets a double kernel.
(set-code (fixture:float-workspace-code))
(eval-current)
(define fdefs (discover:defines (discover:scan)))
; Live type feedback: count + sample a workload window, then retype.
(define fcands (discover:candidates fdefs))
(discover:instrument! fcands)
(discover:observe (lambda () (app-workload-f 20 0.5)))
(define frows (kgen:emit! fdefs (discover:kinds (discover:retype! fcands)) dir))
(display "== kgen: discovered candidates (Float workspace) -> build/gen/*.c") (newline)
(kgen:print frows)
; Float literals: fpoly is not a workspace define (aura#4475), kind given.
(define prows (kgen:emit! (discover:defines (discover:read (fixture:float-literal-src))) (list (list "fpoly" "Float")) dir))
(kgen:print prows)
; Overflow-checked Int kernels (tests/test_kgen_overflow.aura).
(define orows (kgen:emit! (discover:defines (discover:read (fixture:overflow-src))) (fixture:overflow-names) dir))
(display "== kgen: overflow fixtures -> build/gen/*.c") (newline)
(kgen:print orows)
; f64vector kernels (lib/vkgen.aura, tests/test_vkgen.aura). Kinds from live
; sample arguments (vkgen:kinds), the vector data never enters the workspace.
(require "vkgen" all:)
(set-code (fixture:vector-workspace-code))
(eval-current)
(define vdefs (discover:defines (discover:scan)))
(define sv (make-f64vector 4 1.5))
(define (vk-entry name samples) (list name (vkgen:kinds (car (cdr (assoc name vdefs))) samples)))
(define ventries
  (list (vk-entry "vsum" (list sv 4)) (vk-entry "vdot" (list sv sv 4)) (vk-entry "vnorm2" (list sv))
        (vk-entry "vscaled" (list sv 0.5)) (vk-entry "vcount-above" (list sv 0.5)) (vk-entry "vmaxabs" (list sv))
        (vk-entry "vbad-mix" (list sv))))
(display "== vkgen: f64vector workspace -> build/gen/vgen_*.c") (newline)
(vkgen:print (vkgen:emit! vdefs ventries dir))
(set-code (fixture:vector-src))
(eval-current)
(define wdefs (discover:defines (discover:scan)))
(vkgen:print (vkgen:emit! wdefs (list (list "vsum-wrong" (list "V" "I"))) dir))

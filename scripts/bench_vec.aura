; scripts/bench_vec.aura — f64vector kernels vs Aura Soft (run after
; scripts/gen_kernel.sh). ms per call for the Soft loop, the sunk wrapper
; (guards + aux packing + kernel + status), the raw c-func call, and the
; native f64vector-dot primitive (aura#4503) where one exists.
(require "fixture" all:)
(require "vkgen" all:)
(require "std/ffi" all:)
(display "RUN-ONCE") (newline)
(define (mkvec n seed)
  (let ((v (make-f64vector n)))
    (let loop ((i 0))
      (if (< i n) (begin (f64vector-set! v i (- (* 0.1 (modulo (+ (* i 7919) seed) 1000)) 50.3)) (loop (+ i 1))) v))))
(define (time-ms thunk reps)
  (let ((t0 (current-time-ms)))
    (let loop ((i 0)) (if (< i reps) (begin (thunk) (loop (+ i 1))) 0))
    (/ (+ 0.0 (- (current-time-ms) t0)) reps)))
(define lib-sum (c-load (fixture:so (vkgen:base "vsum"))))
(define lib-dot (c-load (fixture:so (vkgen:base "vdot"))))
(define native-f64ret (vkgen:f64ret-native? lib-sum))
(define k-sum (c-func lib-sum (if native-f64ret "sink_vgen_vsum" "sink_vgen_vsum_bits") "(String Int Int) -> Float"))
(define k-dot (c-func lib-dot (if native-f64ret "sink_vgen_vdot" "sink_vgen_vdot_bits") "(String Int String Int Int) -> Float"))
(set-code (fixture:vector-workspace-code))
(eval-current)
; Soft baseline = the workspace defines themselves, timed before the sink.
(define (soft-times n reps)
  (let ((a (mkvec n 17)) (b (mkvec n 4242)))
    (list (time-ms (lambda () (vdot a b n)) reps) (time-ms (lambda () (vsum a n)) reps) (vdot a b n) (vsum a n))))
(define soft-small (soft-times 1000 200))
(define soft-large (soft-times 100000 10))
(mutate:rebind "sink-kernel-vsum" (vkgen:bind-body "vsum" "sink_vgen_vsum" (list "V" "I") "F" lib-sum (fixture:vector-body "vsum")) "bench")
(mutate:rebind "vsum" "(lambda (a0 a1) (sink-kernel-vsum a0 a1))" "bench")
(mutate:rebind "sink-kernel-vdot" (vkgen:bind-body "vdot" "sink_vgen_vdot" (list "V" "V" "I") "F" lib-dot (fixture:vector-body "vdot")) "bench")
(mutate:rebind "vdot" "(lambda (a0 a1 a2) (sink-kernel-vdot a0 a1 a2))" "bench")
(eval-current)
(define (row label n reps soft)
  (let* ((a (mkvec n 17)) (b (mkvec n 4242))
         (aux1 (make-f64vector 1 (+ 0.0 n)))
         (aux2 (let ((x (make-f64vector 2 (+ 0.0 n)))) x))
         (t-soft (car soft))
         (t-sunk (time-ms (lambda () (vdot a b n)) reps))
         (t-raw (time-ms (lambda () (k-dot a n b n n)) reps))
         (t-nat (time-ms (lambda () (f64vector-dot a b)) reps))
         (s-soft (car (cdr soft)))
         (s-sunk (time-ms (lambda () (vsum a n)) reps))
         (s-raw (time-ms (lambda () (k-sum a n n)) reps)))
    (display (list label "n" n "equal" (and (equal? (car (cdr (cdr soft))) (vdot a b n)) (equal? (car (cdr (cdr (cdr soft)))) (vsum a n)))))
    (newline)
    (display (list "  dot ms/call: soft" t-soft "sunk" t-sunk "raw-cfunc" t-raw "native-f64vector-dot" t-nat "speedup" (/ t-soft (if (> t-sunk 0) t-sunk 0.001))))
    (newline)
    (display (list "  sum ms/call: soft" s-soft "sunk" s-sunk "raw-cfunc" s-raw "speedup" (/ s-soft (if (> s-sunk 0) s-sunk 0.001))))
    (newline)))
(display (list "f64 result convention" (if native-f64ret "xmm0 (native)" "rax bits (aura#4531 workaround)"))) (newline)
(row "small" 1000 200 soft-small)
(row "large" 100000 10 soft-large)

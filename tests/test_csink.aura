; tests/test_csink.aura — host-slot sinking (lib/csink.aura,
; policy:sink-host!): a hand-written C kernel installed into a caller-owned
; slot, gated against the workspace define, KEEP / ABORT (wrong kernel) /
; ROLLBACK (threshold out of reach), refusals fall back to the Aura define,
; and the workspace is never mutated (ast:generation unchanged).
(require "expect" all:)
(require "csink" all:)
(require "policy" all:)
(require "score" all:)
(require "std/process" all:)
(score:set-rounds! 3)
(display "RUN-ONCE") (newline)
(set-code "(define sadler (lambda (s start end) (letrec ((loop (lambda (i a b) (if (< i end) (loop (+ i 1) (modulo (+ a (string-ref s i)) 65521) (modulo (+ b (modulo (+ a (string-ref s i)) 65521)) 65521)) (+ (* b 65536) a))))) (loop start 1 0))))\n")
(eval-current)
(define g0 (ast:generation))
(define K #f)
(define (install! k) (set! K k) #t)
(define (entry s a b) (if (and K (string? s)) (let ((r (K s (string-length s) a b))) (if (exact? r) r (sadler s a b))) (sadler s a b)))
(define (call as) (apply entry as))
(define blk (let loop ((i 0) (acc "")) (if (< i 64) (loop (+ i 1) (string-append acc "the quick brown fox jumps over the lazy dog ")) acc)))
(define L (string-length blk))
(define (probe k) (entry blk 0 k))
(define cases (list 0 1 11 L))
(define shadow (list (list blk 0 L) (list "Wikipedia" 0 9) (list "" 0 0) (list "abc" 2 1)))
(define csrc (string-append (getenv "SINK_ROOT") "/kernels/host_demo.c"))
(define path "/tmp/test_csink.jsonl")
(shell (string-append "rm -f " path))
(define r1 (policy:sink-host! "sadler" csrc "host_adler" (list "S" "I" "I") "I" install! call (list blk 0 L) probe cases shadow L 10 1 2 path))
(expect "correct kernel: KEEP" (equal? (policy:get r1 "decision") "KEEP"))
(expect "KEEP: slot holds the kernel" (procedure? K))
(expect "KEEP: speedup over 2x" (> (policy:get r1 "speedup") 2))
(expect "KEEP: entry equals Aura define" (= (entry blk 3 900) (sadler blk 3 900)))
(expect "refusal (non-ASCII) falls back to the define" (= (entry "caf\u00e9" 0 3) (sadler "caf\u00e9" 0 3)))
(define r2 (policy:sink-host! "sadler" csrc "host_wrong" (list "S" "I" "I") "I" install! call (list blk 0 L) probe cases shadow L 10 1 2 path))
(expect "wrong kernel: ABORT at the gate" (and (equal? (policy:get r2 "decision") "ABORT") (equal? (policy:get r2 "stage") "gate")))
(expect "ABORT: slot emptied" (not K))
(define r3 (policy:sink-host! "sadler" csrc "host_adler" (list "S" "I" "I") "I" install! call (list blk 0 L) probe cases shadow L 10 1 1000000 path))
(expect "unreachable threshold: ROLLBACK" (equal? (policy:get r3 "decision") "ROLLBACK"))
(expect "ROLLBACK: slot emptied, define still answers" (and (not K) (= (entry blk 0 L) (sadler blk 0 L))))
(define r4 (policy:sink-host! "nosuch" csrc "host_adler" (list "S" "I" "I") "I" install! call (list blk 0 L) probe cases shadow L 10 1 2 path))
(expect "unknown define: SKIP" (equal? (policy:get r4 "decision") "SKIP"))
(expect "workspace never mutated" (= (ast:generation) g0))
(expect "rows written with action sink-host" (equal? (policy:get r1 "action") "sink-host"))
(expect "checks all passed" (expect-summary))

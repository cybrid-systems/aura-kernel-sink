; tests/test_nmod.aura — stateful native modules (lib/nmod.aura,
; kernels/nmod.h, kernels/nmod_counter.c): build versions by cflags, load with
; identity + ABI checks, handles (stale / foreign refused), gate a candidate
; with a randomized model test against an Aura reference, swap with state
; transfer, reject a wrong version, roll back.
(require "expect" all:)
(require "nmod" all:)
(display "RUN-ONCE") (newline)
(define src (string-append (getenv "SINK_ROOT") "/kernels/nmod_counter.c"))
(define spec (list (list "new" "ctr_new" (list "I") "I") (list "free" "ctr_free" (list "I") "I")
                   (list "add" "ctr_add" (list "I" "I") "I") (list "get" "ctr_get" (list "I") "I")
                   (list "live" "ctr_live" (list) "I") (list "export" "ctr_export" (list "I") "S")
                   (list "import" "ctr_import" (list "S") "I")))
(define so1 (nmod:build! src "counter" "-DCTR_VERSION=1"))
(define so2 (nmod:build! src "counter" "-DCTR_VERSION=2"))
(define sob (nmod:build! src "counter" "-DCTR_VERSION=3 -DCTR_BUG=1"))
(expect "versions build to distinct .so" (and (string? so1) (string? so2) (string? sob) (not (equal? so1 so2))))
(expect "same cflags: same .so (content-addressed)" (equal? so1 (nmod:build! src "counter" "-DCTR_VERSION=1")))
(define m1 (nmod:load so1 spec))
(define m2 (nmod:load so2 spec))
(define mb (nmod:load sob spec))
(expect "load: identity" (and m1 (equal? (nmod:name m1) "counter") (= (nmod:version m1) 1) (= (nmod:version m2) 2)))
(expect "load: unknown symbol -> #f" (not (nmod:load so1 (list (list "x" "no_such_fn" (list "I") "I")))))
(expect "load: over 6 C args -> #f" (not (nmod:load so1 (list (list "x" "ctr_new" (list "I" "I" "I" "I" "I" "I" "I") "I")))))
(expect "load: two String args -> #f (aura#4554)" (not (nmod:load so1 (list (list "x" "ctr_import" (list "S" "S") "I")))))
(define (f m n) (nmod:fn m n))
(define h ((f m1 "new") 10))
(expect "handle > 0" (> h 0))
((f m1 "add") h 5)
(expect "state lives natively" (= ((f m1 "get") h) 15))
(expect "foreign handle (other version's registry) refused" (= ((f m2 "get") h) -1))
(define h2 ((f m1 "new") 0))
((f m1 "free") h2)
(expect "stale handle refused" (and (= ((f m1 "get") h2) -1) (= ((f m1 "add") h2 1) -1)))
(define h3 ((f m1 "new") 0))
(expect "slot reuse gets a new generation" (and (not (= h3 h2)) (= ((f m1 "get") h2) -1) (= ((f m1 "get") h3) 0)))
((f m1 "free") h3)
(expect "NULL String result arrives as 0" (equal? ((f m1 "export") 999) 0))
; gate: randomized ops on a fresh candidate counter vs an Aura reference
(define seed 7)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))
(define (gate cand)
  (let ((c ((nmod:fn cand "new") 0)))
    (let loop ((i 0) (ref 0) (ok #t))
      (if (or (>= i 200) (not ok)) (begin ((nmod:fn cand "free") c) ok)
          (let* ((n (- (rnd! 100) 50)) (r ((nmod:fn cand "add") c n)))
            (loop (+ i 1) (+ ref n) (= r (+ ref n))))))))
(define (transfer om os nm)
  (let ((s ((nmod:fn om "export") os)))
    (if (not (string? s)) #f
        (let ((nh ((nmod:fn nm "import") s (string-length s))))
          (if (> nh 0) (begin ((nmod:fn om "free") os) nh) #f)))))
(define cell (nmod:cell m1 h))
(expect "wrong version: REJECT at the gate" (equal? (nmod:swap! cell mb gate transfer) "REJECT"))
(expect "REJECT: old module and state untouched" (and (equal? (nmod:module cell) m1) (= ((f m1 "get") (nmod:state cell)) 15)))
(expect "failed load: ABORT" (equal? (nmod:swap! cell #f gate transfer) "ABORT"))
(expect "good version: SWAP" (equal? (nmod:swap! cell m2 gate transfer) "SWAP"))
(expect "SWAP: state moved to v2" (and (equal? (nmod:module cell) m2) (= ((f m2 "get") (nmod:state cell)) 15)))
(expect "SWAP: old state freed in v1" (= ((f m1 "live")) 0))
((f m2 "add") (nmod:state cell) 7)
(expect "ROLLBACK: back to v1 with the current state" (and (equal? (nmod:rollback! cell transfer) "ROLLBACK") (equal? (nmod:module cell) m1) (= ((f m1 "get") (nmod:state cell)) 22)))
(expect "ROLLBACK twice: NOOP" (equal? (nmod:rollback! cell transfer) "NOOP"))
(expect-summary)

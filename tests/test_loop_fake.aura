; tests/test_loop_fake.aura — the closed loop with the fake plant:
; reject + heal on wrong / slow / not-worth-it kernels, accept the good one,
; and after an accept a bad attempt heals back to the SUNK version.
(require "expect" all:)
(require "fixture" all:)
(require "plant" all:)
(require "loop" all:)
(require "harness" all:)
(require "std/hot-strategy" all:)
(display "RUN-ONCE") (newline)  ; run_tests.sh fails if this prints twice (silent file re-run)

(define plant (plant:fake))
(define (has? x lst) (cond ((null? lst) #f) ((equal? (car lst) x) #t) (else (has? x (cdr lst)))))

(set-code (fixture:workspace-code))
(eval-current)
(expect "fake: candidates instrumented with live call counters" (fixture:instrument!))
(define aura-100 (hot-sum-sq 100))
(expect "fake: seed workspace, (hot-sum-sq 100) = 328350" (= aura-100 328350))

; Results go through set!: a top-level (define x (f)) where f runs
; mutate:atomic-batch leaves x unbound on the pinned tip (aura#4476).
(define r #f)

(set! r (harness:attempt plant "hot-sum-sq" "wrong" (sink-min-speedup)))
(expect "fake wrong: rejected" (not (loop:accepted? r)))
(expect "fake wrong: reason wrong-result" (has? "wrong-result" (loop:reasons r)))
(expect "fake wrong: ended at score" (string=? (loop:stage r) "score"))
(expect "fake wrong: rolled back and golden re-checked" (and (loop:rolled-back? r) (loop:rollback-ok? r)))
(expect "fake wrong: kernel slot restored to 0" (equal? sink-kernel-hot-sum-sq 0))
(expect "fake wrong: Aura body answers again" (= (hot-sum-sq 100) 328350))
(expect "fake wrong: restored body is still counted" (= ((fixture:observe "hot" 5) "hot-sum-sq") 5))

(set! r (harness:attempt plant "hot-sum-sq" "slow" (sink-min-speedup)))
(expect "fake slow: rejected" (not (loop:accepted? r)))
(expect "fake slow: reason too-slow" (has? "too-slow" (loop:reasons r)))
(expect "fake slow: rolled back and golden re-checked" (and (loop:rolled-back? r) (loop:rollback-ok? r)))
(expect "fake slow: kernel slot restored to 0" (equal? sink-kernel-hot-sum-sq 0))

(set! r (harness:attempt plant "hot-sum-sq" "missing" (sink-min-speedup)))
(expect "fake missing: rejected at load" (and (not (loop:accepted? r)) (string=? (loop:stage r) "load")))
(expect "fake missing: reason load-failed" (has? "load-failed" (loop:reasons r)))
(expect "fake missing: nothing mutated, nothing rolled back" (not (loop:rolled-back? r)))
(expect "fake missing: kernel slot still 0" (equal? sink-kernel-hot-sum-sq 0))

(set! r (harness:attempt plant "cold-add" "good" (sink-min-speedup)))
(expect "fake cold-add: trivial kernel rejected" (not (loop:accepted? r)))
(expect "fake cold-add: reason too-slow" (has? "too-slow" (loop:reasons r)))
(expect "fake cold-add: slot restored, (cold-add 2 3) = 5" (and (equal? sink-kernel-cold-add 0) (= (cold-add 2 3) 5)))

(set! r (harness:attempt plant "hot-sum-sq" "good" (sink-min-speedup)))
(expect "fake good: accepted" (loop:accepted? r))
(expect "fake good: speedup >= (sink-min-speedup)" (>= (loop:speedup r) (sink-min-speedup)))
(expect "fake good: not rolled back" (not (loop:rolled-back? r)))
(expect "fake good: kernel slot holds a procedure" (procedure? sink-kernel-hot-sum-sq))
(expect "fake good: sunk hot-sum-sq is correct" (= (hot-sum-sq 100) 328350))
(expect "fake good: sunk wrapper keeps counting live calls" (= ((fixture:observe "hot" 7) "hot-sum-sq") 7))
(expect "fake good: sunk version is the new last-good" (string=? (hot-strategy:active-name) "hot-sum-sq"))

; A bad attempt after the accept must heal back to the sunk version, not to
; the original Aura body.
(set! r (harness:attempt plant "hot-sum-sq" "wrong" (sink-min-speedup)))
(expect "fake re-wrong: rejected" (not (loop:accepted? r)))
(expect "fake re-wrong: healed and golden re-checked" (loop:rollback-ok? r))
(expect "fake re-wrong: still sunk (slot is a procedure)" (procedure? sink-kernel-hot-sum-sq))
(expect "fake re-wrong: still correct" (= (hot-sum-sq 4999) 41629177499))

; Control-plane knob: an impossible min-speedup rejects even the good kernel.
(set! r (harness:attempt plant "hot-sum-sq" "good" 1000000000))
(expect "fake bar: impossible min-speedup rejects good" (has? "too-slow" (loop:reasons r)))
(expect "fake bar: healed to the previous sunk version" (and (loop:rollback-ok? r) (procedure? sink-kernel-hot-sum-sq)))

(expect "checks all passed" (expect-summary))

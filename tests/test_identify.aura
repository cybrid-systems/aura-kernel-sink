; tests/test_identify.aura — identify decides what to sink; the decision rule
; is a workspace define that mutate:rebind can hot-swap.
(require "expect" all:)
(require "fixture" all:)
(require "identify" all:)
(require "counter" all:)
(display "RUN-ONCE") (newline)  ; run_tests.sh fails if this prints twice (silent file re-run)

(set-code (fixture:workspace-code))
(eval-current)

(expect "counter: candidates hot-swapped into counting wrappers" (fixture:instrument!))
(expect "counter: eval-current starts a fresh window" (= (counter:count 0) 0))
(hot-sum-sq 3) (hot-sum-sq 4) (cold-add 1 2)
(expect "counter: direct calls are counted per define"
        (and (= (counter:count 0) 2) (= (counter:count 1) 1) (= (counter:count 2) 0)))
(expect "counter: counted body is still correct" (and (= (hot-sum-sq 4) 14) (= (cold-add 2 3) 5)))

; Live profile: run the application workload, read the counters.
(define live (fixture:observe "hot" 400))
(expect "counter: hot-sum-sq live calls = 400" (= (live "hot-sum-sq") 400))
(expect "counter: cold-add live calls = 4800" (= (live "cold-add") 4800))
(expect "counter: label-of live calls = 400" (= (live "label-of") 400))
(expect "counter: workload calls do not leak into the next window" (= ((fixture:observe "hot" 0) "hot-sum-sq") 0))
(set! live (fixture:observe "hot" 400))

(define policy (lambda (c m n) (sink-policy c m n)))
(define recs (identify:run (fixture:candidates) fixture:probe policy live))
(identify:print recs)

(define hot (identify:find recs "hot-sum-sq"))
(define cold (identify:find recs "cold-add"))
(define lbl (identify:find recs "label-of"))

(expect "identify: hot-sum-sq is selected" (identify:decide? hot))
(expect "identify: cold-add is not selected (per-call cost under the FFI floor)" (not (identify:decide? cold)))
(expect "identify: label-of is not selected (not numeric)" (not (identify:decide? lbl)))
(expect "identify: hot-sum-sq ranks first" (string=? (identify:name (car recs)) "hot-sum-sq"))
(expect "identify: selected = (hot-sum-sq)" (equal? (identify:selected recs) (list "hot-sum-sq")))
(expect "identify: observed calls come from the live counters" (= (identify:observed hot) 400))
(expect "identify: hot-sum-sq costs more per call than cold-add" (> (identify:ms-per-call hot) (identify:ms-per-call cold)))
(expect "identify: query:calls sees the workload call site of hot-sum-sq" (>= (identify:static hot) 1))
(expect "identify: label-of call sites seen by query:calls" (>= (identify:static lbl) 1))

; Same code, different live traffic: a workload that never calls hot-sum-sq.
(define cold-live (fixture:observe "cold" 400))
(define recs-cold (identify:run (fixture:candidates) fixture:probe policy cold-live))
(expect "live: cold workload reports 0 calls to hot-sum-sq" (= (identify:observed (identify:find recs-cold "hot-sum-sq")) 0))
(expect "live: hot-sum-sq not selected when the workload does not call it" (null? (identify:selected recs-cold)))

; Hot-update the decision rule: raise the budget, nothing qualifies.
(expect "policy: rebind sink-policy (budget 1e9 ms)"
       (equal? (mutate:rebind "sink-policy" (fixture:policy-body 1000000000 50) "raise budget") #t))
(eval-current)
(define recs2 (identify:run (fixture:candidates) fixture:probe policy live))
(expect "policy: raised budget selects nothing" (null? (identify:selected recs2)))

; Lower the per-call floor to 1 us: cold-add now qualifies too.
(expect "policy: rebind sink-policy (budget 1 ms, floor 1 us)"
       (equal? (mutate:rebind "sink-policy" (fixture:policy-body 1 1) "lower floor") #t))
(eval-current)
(define recs3 (identify:run (fixture:candidates) fixture:probe policy live))
(expect "policy: lowered floor also selects cold-add" (identify:decide? (identify:find recs3 "cold-add")))
(expect "policy: label-of still excluded" (not (identify:decide? (identify:find recs3 "label-of"))))

(expect "checks all passed" (expect-summary))

; lib/fixture.aura — the toy workload the MVP sinks.
;
; The workspace (set-code + eval-current) holds three things:
;   1. data-plane candidates: hot-sum-sq (hot numeric loop), cold-add
;      (trivial), label-of (returns strings, not sinkable through c-func Int)
;   2. one kernel slot per sinkable candidate: sink-kernel-<name>, initially 0;
;      a sink rebinds it to (c-func lib "symbol" "sig")
;   3. the control-plane policy, hot-updatable with mutate:rebind:
;      (sink-policy observed-calls ms-per-call numeric?) and (sink-min-speedup)
;
;   4. live call counters (lib/counter.aura): the sink-calls vector, the
;      sink-impl-* originals the counting wrappers call, and app-workload,
;      the stand-in application (hot? = #f never calls hot-sum-sq).
;
; observed-calls is LIVE: fixture:instrument! hot-swaps every candidate into a
; counting wrapper with mutate:rebind and identify reads the counters after a
; workload run (no hard-coded profile any more). ms-per-call is measured;
; static call sites come from (query:calls name).

(export fixture:overflow-src fixture:overflow-names fixture:workspace-code
        fixture:float-workspace-code
        fixture:float-literal-src
        fixture:kind
        fixture:float-candidates
        fixture:aura-body
        fixture:candidates
        fixture:probe
        fixture:cases
        fixture:root
        fixture:so
        fixture:plan
        fixture:policy-body
        fixture:index
        fixture:counted-body
        fixture:instrument!
        fixture:observe)

(require "sink_plan" all:)
(require "counter" all:)
(require "discover" all:)
(require "kgen" all:)

(define (fixture:aura-body name)
  (cond
    ((string=? name "hot-sum-sq")
     "(lambda (n) (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (* i i))) s)))")
    ((string=? name "cold-add") "(lambda (a b) (+ a b))")
    ; Float candidate: no float literal in the body, because float literals
    ; inside workspace procedure bodies read back as 0 on the pinned tip
    ; (aura#4475). Called with float n / h it returns a float; the generated
    ; kernel is double throughout (integer literals become doubles).
    ((string=? name "hot-fsum")
     "(lambda (n h) (let loop ((i 0) (s (- h h))) (if (< i n) (loop (+ i 1) (+ s (* h i i))) s)))")
    ((string=? name "label-of") "(lambda (n) (if (> n 0) \"pos\" \"non-pos\"))")
    (else "")))

;; Policy: sink when the estimated time share is large (calls x ms >= budget-ms)
;; AND one call costs more than an FFI round trip (ms-per-call >= floor-us us),
;; so a trivial body like cold-add is not worth a kernel however often it runs.
;; Integers only: float literals inside workspace procedure bodies read back
;; as 0 on the pinned tip (aura#4475).
(define (fixture:policy-body budget-ms floor-us)
  (string-append "(lambda (calls ms-per-call numeric?) (and numeric? (>= (* calls ms-per-call) "
                 (number->string budget-ms) ") (>= (* 1000 ms-per-call) " (number->string floor-us) ")))"))

(define (fixture:policy-define budget-ms floor-us)
  (string-append "(define sink-policy " (fixture:policy-body budget-ms floor-us) ")\n"))

(define (fixture:workspace-code)
  (string-append
   "(define sink-kernel-hot-sum-sq 0)\n"
   "(define sink-kernel-cold-add 0)\n"
   "(define hot-sum-sq " (fixture:aura-body "hot-sum-sq") ")\n"
   "(define cold-add " (fixture:aura-body "cold-add") ")\n"
   "(define label-of " (fixture:aura-body "label-of") ")\n"
   (fixture:policy-define 50 50)
   "(define (sink-min-speedup) 2)\n"
   (counter:workspace-code (discover:max-candidates))
   ; Original bodies under a second name: the counting wrapper calls these, so
   ; the counted baseline costs tick + one call, the same as the counted sink
   ; wrapper (an inline ((lambda ...) a0) would allocate a closure per call and
   ; make every kernel look faster than it is).
   "(define sink-impl-hot-sum-sq " (fixture:aura-body "hot-sum-sq") ")\n"
   "(define sink-impl-cold-add " (fixture:aura-body "cold-add") ")\n"
   ; The live workload: one procedure, `hot?` = #f never calls hot-sum-sq.
   ; Per round: hot-sum-sq x1 (if hot?), cold-add x12, label-of x1.
   "(define (app-workload rounds hot?) (if (> rounds 0) (begin (if hot? (hot-sum-sq 100) 0) (let adds ((k 12) (acc 0)) (if (> k 0) (adds (- k 1) (cold-add acc k)) acc)) (label-of rounds) (app-workload (- rounds 1) hot?)) 0))\n"))

; Float workspace: one Float candidate (hot-fsum), one Int (cold-add), one
; neither (label-of), same control plane. Kept separate from the Int workspace
; so neither crosses 8 procedure defines (aura#4479). The workload takes the
; float h as a parameter (no float literal in a workspace body, aura#4475).
(define (fixture:float-workspace-code)
  (string-append
   "(define sink-kernel-hot-fsum 0)\n"
   "(define hot-fsum " (fixture:aura-body "hot-fsum") ")\n"
   "(define cold-add " (fixture:aura-body "cold-add") ")\n"
   "(define label-of " (fixture:aura-body "label-of") ")\n"
   (fixture:policy-define 50 50)
   "(define (sink-min-speedup) 2)\n"
   (counter:workspace-code (discover:max-candidates))
   "(define sink-impl-hot-fsum " (fixture:aura-body "hot-fsum") ")\n"
   "(define (app-workload-f rounds h) (if (> rounds 0) (begin (hot-fsum (* h 200) h) (cold-add rounds 1) (label-of rounds) (app-workload-f (- rounds 1) h)) 0))\n"))

; A Float define WITH float literals, used outside the workspace (the golden
; reference is a host-file define, where literals evaluate correctly).
(define (fixture:float-literal-src)
  "(define fpoly (lambda (x) (+ (* 1.5 x x) (* 0.25 x) -2.0)))")

;; Overflow-checked Int kernels (kernels/sink_abi.h sink_ck_*): one define per
;; checked op, plus the (+ c c 2) chain shape of aura#4462. Host-file defines
;; with the same bodies are the Aura reference for in-range inputs.
(define (fixture:overflow-src)
  (string-append
   "(define ov-add (lambda (a b) (+ a b)))\n"
   "(define ov-sub (lambda (a b) (- a b)))\n"
   "(define ov-mul (lambda (a b) (* a b)))\n"
   "(define ov-neg (lambda (a) (- a)))\n"
   "(define ov-chain (lambda (c) (+ c c 2)))\n"
   "(define ov-pow (lambda (b k) (letrec ((lp (lambda (i acc) (if (< i k) (lp (+ i 1) (* acc b)) acc)))) (lp 0 1))))\n"))
(define (fixture:overflow-names) (list "ov-add" "ov-sub" "ov-mul" "ov-neg" "ov-chain" "ov-pow"))

; c-func scalar kind of a fixture candidate.
(define (fixture:kind name) (if (string=? name "hot-fsum") "Float" "Int"))

; Counter slot of each candidate in sink-calls.
(define (fixture:index name)
  (cond ((>= (discover:index name) 0) (discover:index name))
        ((string=? name "hot-sum-sq") 0)
        ((string=? name "cold-add") 1)
        ((string=? name "label-of") 2)
        (else -1)))

(define (fixture-arity name) (if (or (string=? name "cold-add") (string=? name "hot-fsum")) 2 1))

; The instrumented (counting) Aura body: the rollback target of a sink.
(define (fixture:counted-body name)
  (counter:wrap (fixture-impl name) (fixture:index name) (fixture-arity name)))

; What the counting wrapper calls. label-of is never sunk, so it wraps its
; body inline instead of spending a ninth workspace procedure (aura#4479).
(define (fixture-impl name)
  (if (string=? name "label-of") (fixture:aura-body name) (string-append "sink-impl-" name)))

; Hot-swap all candidates into counting wrappers (mutate:rebind), then
; eval-current. Returns #t when every rebind succeeded.
(define (fixture:instrument!)
  (let ((ok (and (equal? (counter:instrument! "hot-sum-sq" 0 1 "sink-impl-hot-sum-sq") #t)
                 (equal? (counter:instrument! "cold-add" 1 2 "sink-impl-cold-add") #t)
                 (equal? (counter:instrument! "label-of" 2 1 (fixture-impl "label-of")) #t))))
    (eval-current)
    ok))

; Run a workload ("hot" or "cold") for `rounds` and return name -> live calls.
(define (fixture:observe kind rounds)
  (let ((at (counter:observe (if (string=? kind "cold")
                                 (lambda () (app-workload rounds #f))
                                 (lambda () (app-workload rounds #t))))))
    (lambda (name) (let ((i (fixture:index name))) (if (< i 0) 0 (at i))))))

; Candidate rows: (name arity numeric? counter-index bench-arg bench-reps)
; No call counts here: they come from the live counters (fixture:observe).
(define (fixture:candidates)
  (list (list "hot-sum-sq" 1 #t 0 5000 60)
        (list "cold-add" 2 #t 1 7 2000)
        (list "label-of" 1 #f 2 5 2000)))

; Float workspace rows (same shape); kept apart so Int-workspace callers of
; fixture:candidates never probe hot-fsum, which only exists there.
(define (fixture:float-candidates)
  (list (list "hot-fsum" 2 #t 0 5000 60)))

; Unary probes. Each looks the workspace name up at call time, so after a
; mutate:rebind the probe calls the new binding.
(define (fixture:probe name)
  (cond
    ((string=? name "hot-sum-sq") (lambda (x) (hot-sum-sq x)))
    ((string=? name "cold-add") (lambda (x) (cold-add x 1)))
    ((string=? name "label-of") (lambda (x) (label-of x)))
    ((string=? name "hot-fsum") (lambda (x) (hot-fsum (+ 0.0 x) 0.5)))
    (else (lambda (x) x))))

; Correctness cases (results stay well inside the fixnum range).
(define (fixture:cases name)
  (cond
    ((string=? name "hot-sum-sq") (list 0 1 2 3 10 100 1000 4999 20000))
    ((string=? name "cold-add") (list -5 0 1 41 1000000))
    ((string=? name "hot-fsum") (list 0 1 2 3 10 100 1000 4999))
    (else (list 0 1 5))))

; Repo root: SINK_ROOT if set, else the current directory (scripts cd there).
(define (fixture:root)
  (let ((r (getenv "SINK_ROOT")))
    (if (and (string? r) (> (string-length r) 0)) r ".")))

(define (fixture:so base)
  (string-append (fixture:root) "/build/kernels/lib" base ".so"))

; FakePlant stand-ins (Aura bodies bound into the kernel slot instead of C).
;   good   closed form n(n-1)(2n-1)/6, really faster than the loop
;   wrong  off by one
;   slow   correct but loops four times
(define (fixture-fake name variant)
  (cond
    ((string=? name "cold-add") "(lambda (a b) (+ b a))")
    ((string=? name "hot-fsum") "(lambda (n h) (if (< n 1) (- h h) (* h (/ (* n (- n 1) (- (* 2 n) 1)) 6))))")
    ((string=? variant "good") "(lambda (n) (if (< n 1) 0 (quotient (* n (- n 1) (- (* 2 n) 1)) 6)))")
    ((string=? variant "wrong") "(lambda (n) (if (< n 1) 1 (+ 1 (quotient (* n (- n 1) (- (* 2 n) 1)) 6))))")
    ((string=? variant "slow")
     "(lambda (n) (let rep ((k 0) (r 0)) (if (< k 4) (rep (+ k 1) (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (* i i))) s))) r)))")
    (else "")))

; Plans used by the demo and tests. variant: "generated" "good" "wrong" "slow" "missing"
; for hot-sum-sq; cold-add always uses example_add.
(define (fixture:plan name variant)
  (fixture-counted (fixture-plan-raw name variant)))

; Keep counting through a sink: rollback target = counted Aura body, sunk
; wrapper = counted call through the kernel slot.
(define (fixture-counted p)
  (let ((name (sink-plan:name p)))
    (list name (sink-plan:slot p) (sink-plan:so p) (sink-plan:symbol p) (sink-plan:sig p)
          (sink-plan:arity p) (fixture:counted-body name)
          (counter:wrap (sink-plan:slot p) (fixture:index name) (sink-plan:arity p))
          (sink-plan:fake p))))

; variant "generated": the kernel lib/kgen.aura emitted from the workspace
; define itself (scripts/gen_kernel.sh -> build/kernels/libgen_<name>.so).
(define (fixture-plan-raw name variant)
  (cond
    ((string=? variant "generated")
     (sink-plan:make-kind name (fixture:so (kgen:base name)) (kgen:symbol name) (fixture-arity name)
                          (fixture:aura-body name) (fixture-fake name "good") (fixture:kind name)))
    ((string=? name "cold-add")
     (sink-plan:make "cold-add" (fixture:so "example_add") "sink_add" 2
                     (fixture:aura-body "cold-add") (fixture-fake "cold-add" "good")))
    ((string=? variant "wrong")
     (sink-plan:make name (fixture:so "bad_wrong") "sink_sum_sq" 1
                     (fixture:aura-body name) (fixture-fake name "wrong")))
    ((string=? variant "slow")
     (sink-plan:make name (fixture:so "bad_slow") "sink_sum_sq" 1
                     (fixture:aura-body name) (fixture-fake name "slow")))
    ((string=? variant "missing")
     (sink-plan:make name (fixture:so "does_not_exist") "sink_sum_sq" 1
                     (fixture:aura-body name) ""))
    (else
     (sink-plan:make name (fixture:so "sum_sq") "sink_sum_sq" 1
                     (fixture:aura-body name) (fixture-fake name "good")))))

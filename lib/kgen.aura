; lib/kgen.aura — minimal C kernel generator.
;
; Input: one discovered workspace define as a tree from discover:read, i.e.
;   (lambda (p ...) BODY)   atoms are strings, as (query:code) prints them.
; Output: (list #t c-source) or (list #f reason). Never a guessed kernel: any
; form outside the subset below is a skip with a reason.
;
; Two kernel types, chosen per define by the caller (discover classifies):
;   Int    kgen:compile        int64_t / C long, fixnum arithmetic
;   Float  kgen:compile-float  double; float literals allowed, integer
;          literals become doubles (Aura mixes them exactly below 2^53)
;
; Supported subset (shared by both types):
;   expressions  integer literals, parameters / loop variables,
;                (+ e ...) (- e ...) (* e ...), (if COND e e)
;   conditions   (< a b) (> a b) (<= a b) (>= a b) (= a b), (and ..) (or ..)
;                (not c), #t #f
;   tail forms   (if COND tail tail); a tail call to the define itself or to
;                a letrec loop -> goto (named let desugars to
;                (letrec ((L (lambda (v ..) BODY))) (L init ..)));
;                anything else -> return EXPR
; Rejected with a reason: string / boolean values, float literals in an Int
; kernel, other calls
; (callbacks into Aura are impossible from a kernel), non-tail recursion,
; remainder / modulo / Float division, begin / set! / multi-form bodies.
;
; Int arithmetic is overflow-checked against the Aura fixnum range
; [-2^62, 2^62-1]: every + - * (and unary -) goes through sink_ck_add / sink_ck_sub /
; sink_ck_mul / sink_ck_neg from kernels/sink_abi.h (__builtin_*_overflow + range
; check), which set the kernel-local flag `ovf`. Every return and every loop
; jump tests the flag (a return also refuses results <= -5*10^15, which the
; pinned Aura cannot take back across c-func; see sink_abi.h); on overflow the kernel stops (goto ovf_exit), records it
; in a thread-local status and returns 0. The status is exported as
; <symbol>_overflowed (() -> Int, read-and-clear); sink-plan:bind-body wraps
; generated Int kernels so a nonzero status raises an Aura error
; ("sink: int overflow ...") instead of returning the sentinel. Aura Soft has
; no defined result here (it SIGABRTs, aura#4462), so fail-closed is the match.
; Float kernels are IEEE double, unchecked (Aura Float is double too).

(export kgen:compile kgen:compile-float kgen:compile-kind kgen:symbol kgen:base kgen:supported? kgen:emit! kgen:print)

; Current kernel type while one compile runs: #f = Int, #t = Float.
(define kg-float-mode #f)
(define (kg-ty) (if kg-float-mode "double" "int64_t"))
(define (kg-ret-ty) (if kg-float-mode "double" "long"))
(define (kg-kind) (if kg-float-mode "Float" "Int"))

(define (kg-ok v) (list #t v))
(define (kg-err r) (list #f r))
(define (kg-ok? r) (car r))
(define (kg-val r) (car (cdr r)))

(define (kg-strlit? a) (and (string? a) (> (string-length a) 0) (= (string-ref a 0) 34)))

(define (kg-len xs) (if (null? xs) 0 (+ 1 (kg-len (cdr xs)))))

; C identifier for a define name: [A-Za-z0-9] kept, everything else -> _
(define (kg-c-char s i)
  (let ((c (string-ref s i)))
    (if (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)))
        (substring s i (+ i 1))
        "_")))
(define (kg-sanitize s)
  (let loop ((i 0) (acc ""))
    (if (>= i (string-length s)) acc (loop (+ i 1) (string-append acc (kg-c-char s i))))))

(define (kgen:symbol name) (string-append "sink_gen_" (kg-sanitize name)))
; build/gen/<base>.c -> build/kernels/lib<base>.so
(define (kgen:base name) (string-append "gen_" (kg-sanitize name)))

; Decimal integer literals are recognised lexically and emitted verbatim
; (INT64_C(<text>)): on the pinned tip string->number goes through double, so
; it rounds above 2^53 and SIGABRTs (uncatchable) at 2^62-1 (aura#4485).
; Accepted magnitude: <= 2^62-1 (fixnum max); C sees the exact value.
(define (kg-digit? c) (and (>= c 48) (<= c 57)))
(define (kg-digits? a i) (cond ((>= i (string-length a)) #t) ((kg-digit? (string-ref a i)) (kg-digits? a (+ i 1))) (else #f)))
(define (kg-int-text? a)
  (and (string? a) (not (kg-strlit? a))
       (let ((s (if (and (> (string-length a) 1) (= (string-ref a 0) 45)) 1 0)))
         (and (> (string-length a) s) (kg-digits? a s)))))
(define (kg-int-literal? a)
  (and (kg-int-text? a)
       (let* ((s (if (= (string-ref a 0) 45) 1 0)) (m (substring a s (string-length a))) (n (string-length m)))
         (or (< n 19) (and (= n 19) (not (string>? m "4611686018427387903")))))))
(define (kg-float-literal? a)
  (and (string? a) (not (kg-strlit? a))
       (let ((n (try (string->number a) (catch (e) #f))))
         (and (number? n) (or (float? n) (integer? n))))))
; C double literal for an Aura numeric atom; always carries a dot or exponent.
(define (kg-c-double a)
  (string-append "(" a (if (kg-has-dot? a 0) "" ".0") ")"))
(define (kg-has-dot? a i)
  (cond ((>= i (string-length a)) #f)
        ((= (string-ref a i) 46) #t)
        ((= (string-ref a i) 101) #t)   ; exponent: 1e3 reads as a float
        (else (kg-has-dot? a (+ i 1)))))

; env: list of (aura-name c-name); loops: list of (name depth c-vars)
(define (kg-lookup x al)
  (cond ((null? al) #f) ((equal? (car (car al)) x) (car al)) (else (kg-lookup x (cdr al)))))

(define (kg-arith op args env loops)
  (let loop ((xs args) (acc "") (first #t))
    (if (null? xs)
        (kg-ok (if kg-float-mode (string-append "(" acc ")") acc))
        (let ((r (kg-expr (car xs) env loops)))
          (if (kg-ok? r)
              (loop (cdr xs)
                    (cond (first (kg-val r))
                          (kg-float-mode (string-append acc " " op " " (kg-val r)))
                          ; Int: left fold, one checked op per step (as Aura)
                          (else (string-append (kg-checked op) "(" acc ", " (kg-val r) ", &ovf)")))
                    #f)
              r)))))
(define (kg-checked op)
  (cond ((string=? op "+") "sink_ck_add") ((string=? op "-") "sink_ck_sub") (else "sink_ck_mul")))

; left fold of sink_ck_quo: (/ a b c) = (quotient (quotient a b) c)
(define (kg-quo args env loops)
  (let loop ((xs args) (acc "") (first #t))
    (if (null? xs)
        (kg-ok acc)
        (let ((r (kg-expr (car xs) env loops)))
          (if (kg-ok? r)
              (loop (cdr xs) (if first (kg-val r) (string-append "sink_ck_quo(" acc ", " (kg-val r) ", &ovf)")) #f)
              r)))))

(define (kg-expr t env loops)
  (cond
    ((string? t)
     (cond ((kg-strlit? t) (kg-err (string-append "string literal (not " (kg-kind) ")")))
           ((or (string=? t "#t") (string=? t "#f")) (kg-err (string-append "boolean value (not " (kg-kind) ")")))
           ((and kg-float-mode (kg-float-literal? t)) (kg-ok (kg-c-double t)))
           ((kg-int-literal? t) (kg-ok (string-append "INT64_C(" t ")")))
           ((kg-lookup t env) (kg-ok (car (cdr (kg-lookup t env)))))
           ((kg-int-text? t) (kg-err (string-append "integer literal " t " outside the Aura fixnum range")))
           ((and (string->number t) #t) (kg-err (string-append "non-integer literal " t)))
           (else (kg-err (string-append "free variable " t)))))
    ((null? t) (kg-err "empty form"))
    ((not (string? (car t))) (kg-err "computed operator"))
    (else
     (let ((h (car t)) (args (cdr t)))
       (cond
         ((and (string=? h "+") (null? args)) (kg-ok (if kg-float-mode "(0.0)" "INT64_C(0)")))
         ((and (string=? h "*") (null? args)) (kg-ok (if kg-float-mode "(1.0)" "INT64_C(1)")))
         ((string=? h "+") (kg-arith "+" args env loops))
         ((string=? h "*") (kg-arith "*" args env loops))
         ((and (string=? h "-") (= (kg-len args) 1))
          (let ((r (kg-expr (car args) env loops)))
            (if (kg-ok? r)
                (kg-ok (if kg-float-mode (string-append "(-" (kg-val r) ")")
                           (string-append "sink_ck_neg(" (kg-val r) ", &ovf)")))
                r)))
         ((and (string=? h "-") (> (kg-len args) 1)) (kg-arith "-" args env loops))
         ((and (string=? h "if") (= (kg-len args) 3))
          (let ((c (kg-cond (car args) env loops))
                (a (kg-expr (car (cdr args)) env loops))
                (b (kg-expr (car (cdr (cdr args))) env loops)))
            (cond ((not (kg-ok? c)) c) ((not (kg-ok? a)) a) ((not (kg-ok? b)) b)
                  (else (kg-ok (string-append "(" (kg-val c) " ? " (kg-val a) " : " (kg-val b) ")"))))))
         ((kg-lookup h loops) (kg-err (string-append "non-tail recursive call to " h)))
         ; Int quotient / Int `/` (Aura truncates both): checked, divisor tested before `/`
         ((and (not kg-float-mode) (string=? h "quotient") (= (kg-len args) 2)) (kg-quo args env loops))
         ((and (not kg-float-mode) (string=? h "/") (> (kg-len args) 1)) (kg-quo args env loops))
         ((or (string=? h "quotient") (string=? h "remainder") (string=? h "modulo") (string=? h "/"))
          (kg-err (string-append "division " h " unsupported (only Int quotient and Int / with 2+ args)")))
         (else (kg-err (string-append "unsupported call " h))))))))

(define (kg-cmp? h) (or (string=? h "<") (string=? h ">") (string=? h "<=") (string=? h ">=") (string=? h "=")))

(define (kg-logic op args env loops)
  (let loop ((xs args) (acc "") (first #t))
    (if (null? xs)
        (kg-ok (if first (if (string=? op "&&") "1" "0") (string-append "(" acc ")")))
        (let ((r (kg-cond (car xs) env loops)))
          (if (kg-ok? r)
              (loop (cdr xs) (string-append acc (if first "" (string-append " " op " ")) (kg-val r)) #f)
              r)))))

(define (kg-cond t env loops)
  (cond
    ((and (string? t) (string=? t "#t")) (kg-ok "1"))
    ((and (string? t) (string=? t "#f")) (kg-ok "0"))
    ((or (string? t) (null? t) (not (string? (car t))))
     (kg-err "condition is not a comparison (Aura truthiness of Int differs from C)"))
    ((and (kg-cmp? (car t)) (= (kg-len (cdr t)) 2))
     (let ((a (kg-expr (car (cdr t)) env loops)) (b (kg-expr (car (cdr (cdr t))) env loops)))
       (cond ((not (kg-ok? a)) a) ((not (kg-ok? b)) b)
             (else (kg-ok (string-append "(" (kg-val a) " " (if (string=? (car t) "=") "==" (car t)) " " (kg-val b) ")"))))))
    ((string=? (car t) "and") (kg-logic "&&" (cdr t) env loops))
    ((string=? (car t) "or") (kg-logic "||" (cdr t) env loops))
    ((and (string=? (car t) "not") (= (kg-len (cdr t)) 1))
     (let ((r (kg-cond (car (cdr t)) env loops))) (if (kg-ok? r) (kg-ok (string-append "(!" (kg-val r) ")")) r)))
    (else (kg-err (string-append "unsupported condition " (car t))))))

; c-vars for loop depth d: l<d>_0 ...
(define (kg-vars d n)
  (let loop ((k (- n 1)) (acc (list)))
    (if (< k 0) acc
        (loop (- k 1) (cons (string-append "l" (number->string d) "_" (number->string k)) acc)))))

(define (kg-bind names cvars env)
  (if (null? names) env (kg-bind (cdr names) (cdr cvars) (cons (list (car names) (car cvars)) env))))

(define (kg-all-strings? xs) (cond ((null? xs) #t) ((and (string? (car xs)) (not (kg-strlit? (car xs)))) (kg-all-strings? (cdr xs))) (else #f)))

; Tail call to a loop: evaluate all args into temps, assign, goto.
(define (kg-jump loop args env loops ind)
  (let ((d (number->string (car (cdr loop)))) (cvars (car (cdr (cdr loop)))))
    (if (not (= (kg-len args) (kg-len cvars)))
        (kg-err (string-append "arity mismatch in call to " (car loop)))
        (let walk ((xs args) (vs cvars) (k 0) (decl "") (asg ""))
          (if (null? xs)
              (kg-ok (string-append ind "{\n" decl (kg-ovf-check (string-append ind "  ")) asg ind "  goto top_" d ";\n" ind "}\n"))
              (let ((r (kg-expr (car xs) env loops)) (tmp (string-append "t" d "_" (number->string k))))
                (if (kg-ok? r)
                    (walk (cdr xs) (cdr vs) (+ k 1)
                          (string-append decl ind "  " (kg-ty) " " tmp " = " (kg-val r) ";\n")
                          (string-append asg ind "  " (car vs) " = " tmp ";\n"))
                    r)))))))

; (letrec ((L (lambda (v ..) BODY))) (L init ..))
(define (kg-letrec-loop? t)
  (and (pair? t) (= (kg-len t) 3) (equal? (car t) "letrec")
       (pair? (car (cdr t))) (= (kg-len (car (cdr t))) 1)
       (let ((b (car (car (cdr t)))))
         (and (pair? b) (= (kg-len b) 2) (string? (car b))
              (let ((lam (car (cdr b))))
                (and (pair? lam) (= (kg-len lam) 3) (equal? (car lam) "lambda")
                     (pair? (car (cdr lam))) (kg-all-strings? (car (cdr lam)))))
              (let ((call (car (cdr (cdr t)))))
                (and (pair? call) (equal? (car call) (car b))))))))

(define (kg-loop t env loops ind)
  (let* ((b (car (car (cdr t))))
         (name (car b))
         (lam (car (cdr b)))
         (params (car (cdr lam)))
         (body (car (cdr (cdr lam))))
         (inits (cdr (car (cdr (cdr t)))))
         (d (+ 1 (kg-len loops)))
         (cvars (kg-vars d (kg-len params))))
    (if (not (= (kg-len inits) (kg-len params)))
        (kg-err (string-append "arity mismatch in loop " name))
        (let walk ((xs inits) (vs cvars) (decl ""))
          (if (null? xs)
              (let ((r (kg-stmt body (kg-bind params cvars env)
                                (cons (list name d cvars) loops) (string-append ind "  "))))
                (if (kg-ok? r)
                    (kg-ok (string-append ind "{\n" decl (kg-ovf-check (string-append ind "  ")) ind "top_" (number->string d) ": ;\n" (kg-val r) ind "}\n"))
                    r))
              (let ((r (kg-expr (car xs) env loops)))
                (if (kg-ok? r)
                    (walk (cdr xs) (cdr vs) (string-append decl ind "  " (kg-ty) " " (car vs) " = " (kg-val r) ";\n"))
                    r)))))))

(define (kg-stmt t env loops ind)
  (cond
    ((and (pair? t) (equal? (car t) "if") (= (kg-len t) 4))
     (let ((c (kg-cond (car (cdr t)) env loops))
           (a (kg-stmt (car (cdr (cdr t))) env loops (string-append ind "  ")))
           (b (kg-stmt (car (cdr (cdr (cdr t)))) env loops (string-append ind "  "))))
       (cond ((not (kg-ok? c)) c) ((not (kg-ok? a)) a) ((not (kg-ok? b)) b)
             (else (kg-ok (string-append ind "if " (kg-val c) " {\n" (kg-val a) ind "} else {\n" (kg-val b) ind "}\n"))))))
    ((kg-letrec-loop? t) (kg-loop t env loops ind))
    ((and (pair? t) (string? (car t)) (kg-lookup (car t) loops))
     (kg-jump (kg-lookup (car t) loops) (cdr t) env loops ind))
    ((and (pair? t) (member-of? (car t) (list "begin" "set!" "let" "let*" "letrec" "define" "lambda")))
     (kg-err (string-append "unsupported form " (car t))))
    (else
     (let ((r (kg-expr t env loops)))
       (if (kg-ok? r)
           (kg-ok (if kg-float-mode
                      (string-append ind "return " (kg-val r) ";\n")
                      (string-append ind "{\n" ind "  int64_t r_ = " (kg-val r) ";\n"
                                     ind "  if (sink_ck_ret(r_, ovf)) goto ovf_exit;\n"
                                     ind "  return r_;\n" ind "}\n")))
           r)))))

; Int only: leave the kernel as soon as an arithmetic step overflowed.
(define (kg-ovf-check ind)
  (if kg-float-mode "" (string-append ind "if (ovf) goto ovf_exit;\n")))

(define (member-of? x xs) (cond ((null? xs) #f) ((equal? x (car xs)) #t) (else (member-of? x (cdr xs)))))

(define (kg-params s n)
  (let loop ((k 0) (acc ""))
    (if (>= k n) acc
        (loop (+ k 1) (string-append acc (if (= k 0) "" ", ") s (number->string k))))))

; name: define name; tree: (lambda (p ..) BODY). Returns (#t c-source) | (#f reason).
(define (kgen:compile name tree) (kgen:compile-kind name tree "Int"))
(define (kgen:compile-float name tree) (kgen:compile-kind name tree "Float"))

; kind: "Int" | "Float". Anything else is a skip.
(define (kgen:compile-kind name tree kind)
  (cond ((equal? kind "Int") (set! kg-float-mode #f) (kg-compile name tree))
        ((equal? kind "Float")
         (set! kg-float-mode #t)
         (let ((r (kg-compile name tree))) (set! kg-float-mode #f) r))
        ; not classified: report the precise static reason when there is one
        (else (set! kg-float-mode #f)
              (let ((r (kg-compile name tree)))
                (if (kg-ok? r) (kg-err "not Int- or Float-callable (runtime probe)") r)))))

(define (kg-compile name tree)
  (cond
    ((not (and (pair? tree) (equal? (car tree) "lambda"))) (kg-err "not a lambda"))
    ((not (= (kg-len tree) 3)) (kg-err "body is not a single form"))
    ((not (and (pair? (car (cdr tree))) (kg-all-strings? (car (cdr tree)))))
     (kg-err "variadic or zero-arity lambda"))
    ((> (kg-len (car (cdr tree))) 4) (kg-err "more than 4 parameters"))
    (else
     (let* ((params (car (cdr tree)))
            (n (kg-len params))
            (cvars (kg-vars 0 n))
            (r (kg-stmt (car (cdr (cdr tree))) (kg-bind params cvars (list))
                        (list (list name 0 cvars)) "  ")))
       (if (not (kg-ok? r))
           r
           (kg-ok
            (string-append
             "/* GENERATED by lib/kgen.aura (" (kg-kind) " kernel) from the workspace define `" name "`. Do not edit. */\n"
             "#include <stdint.h>\n#include \"sink_abi.h\"\nAURA_SINK_MODULE\n\n"
             (if kg-float-mode "" (string-append "AURA_SINK_OVF_DECL(" (kgen:symbol name) ")\n"))
             "AURA_SINK_EXPORT " (kg-ret-ty) " " (kgen:symbol name) "(" (kg-params (string-append (kg-ret-ty) " a") n) ") {\n"
             (if kg-float-mode "" "  int ovf = 0;\n")
             (kg-decl0 cvars 0)
             "top_0: ;\n"
             (kg-val r)
             (if kg-float-mode ""
                 (string-append "ovf_exit:\n  " (kgen:symbol name) "_ovf_ = ovf ? ovf : 1;\n  return 0;\n"))
             "}\n"
             (if kg-float-mode "" (string-append "AURA_SINK_OVF_STATUS(" (kgen:symbol name) ")\n")))))))))

(define (kg-decl0 cvars k)
  (if (null? cvars) ""
      (string-append "  " (kg-ty) " " (car cvars) " = a" (number->string k) ";\n" (kg-decl0 (cdr cvars) (+ k 1)))))

(define (kgen:supported? name tree) (kg-ok? (kgen:compile name tree)))

; Generate one C file per entry of names (trees looked up in defs, the
; discover:defines output) into dir/<base>.c. An entry is a name (Int kernel)
; or (name kind) with kind "Int" | "Float" | #f (#f = skipped). Returns rows
;   (name "generated" path) | (name "skipped" reason)
(define (kgen:emit! defs names dir)
  (let loop ((ns names) (acc (list)))
    (if (null? ns)
        (kg-rev acc)
        (let* ((name (if (pair? (car ns)) (car (car ns)) (car ns)))
               (kind (if (pair? (car ns)) (car (cdr (car ns))) "Int"))
               (d (kg-lookup name defs)))
          (if (not d)
              (loop (cdr ns) (cons (list name "skipped" "no such define") acc))
              (let ((r (kgen:compile-kind name (car (cdr d)) kind)))
                (if (kg-ok? r)
                    (let ((path (string-append dir "/" (kgen:base name) ".c")))
                      (if (equal? (try (write-file path (kg-val r)) (catch (e) #f)) #f)
                          (loop (cdr ns) (cons (list name "skipped" (string-append "cannot write " path)) acc))
                          (loop (cdr ns) (cons (list name "generated" path) acc))))
                    (loop (cdr ns) (cons (list name "skipped" (kg-val r)) acc)))))))))

(define (kg-rev xs) (let loop ((xs xs) (acc (list))) (if (null? xs) acc (loop (cdr xs) (cons (car xs) acc)))))

(define (kgen:print rows)
  (if (null? rows) #t
      (let ((r (car rows)))
        (display "  ") (display (car (cdr r))) (display " ") (display (car r))
        (display ": ") (display (car (cdr (cdr r)))) (newline)
        (kgen:print (cdr rows)))))

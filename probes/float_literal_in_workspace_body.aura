; Float literals inside workspace procedure bodies read back as 0.
; Run: AURA_SANDBOX=off AURA_PIPELINE_STRICT=0 aura probes/float_literal_in_workspace_body.aura
; Expected: (0.05 2.75 5 0.5 1.05) / 0.25    Pinned tip prints: (0 0 0 0.5 1) / 0.25
(set-code "(define (z1) 0.05)\n(define (z2) 2.75)\n(define (z3 m) (* m 2.5))\n(define z4 0.5)\n(define (z5 m) (+ m 0.05))")
(eval-current)
(display (list (z1) (z2) (z3 2) z4 (z5 1))) (newline)
(mutate:rebind "z1" "(lambda () 0.25)" "f")
(eval-current)
(display (z1)) (newline)

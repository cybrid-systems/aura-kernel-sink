; Repro for aura#4479: the 9th procedure define in a workspace makes calls to
; an unrelated workspace define ~35x slower (Soft, AURA_SANDBOX=off AURA_PIPELINE_STRICT=0).
(define (bench p) (let ((t0 (current-time-ms))) (let loop ((i 0)) (if (< i 20) (begin (p 5000) (loop (+ i 1))) 0)) (- (current-time-ms) t0)))
(define H "(define hot-sum-sq (lambda (n) (let loop ((i 0) (s 0)) (if (< i n) (loop (+ i 1) (+ s (* i i))) s))))\n")
(define (lams k) (if (= k 0) "" (string-append "(define f" (number->string k) " (lambda (x) (+ x " (number->string k) ")))\n" (lams (- k 1)))))
(define (go k) (if (<= k 12) (begin (set-code (string-append H (lams k))) (eval-current) (display (list (+ k 1) "procs" (bench (lambda (x) (hot-sum-sq x))))) (newline) (go (+ k 1))) 0))
(go 4)
